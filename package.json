{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Portfolio site and master record: Foldkit prerendered pages on the Rat Stack floor.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm run lockfile:check && turbo run typecheck typecheck-scripts && oxlint && oxfmt --check .",
    "dev": "pnpm --filter @portfolio/site dev",
    "fix": "oxlint --fix && oxfmt .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint && oxfmt --check .",
    "lockfile:check": "pnpm --config.optimistic-repeat-install=false install --frozen-lockfile --offline --lockfile-only --ignore-scripts",
    "prepare": "if git rev-parse --git-dir >/dev/null 2>&1; then lefthook install; fi",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck typecheck-scripts",
    "typecheck-scripts": "effect-tsrs diagnostics --project tsconfig.json --strict --type-check"
  },
  "devDependencies": {
    "@foldkit/oxlint-plugin": "0.15.4",
    "@oxlint/plugins": "1.88.0",
    "@types/node": "24.19.2",
    "@yielded/effect-tsrs": "0.2.3",
    "effect": "4.1.4",
    "lefthook": "2.2.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "turbo": "2.11.9",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.3.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.18.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=11.1.2"
  },
  "packageManager": "pnpm@11.3.0"
}
